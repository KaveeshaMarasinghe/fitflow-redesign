{
  "cli": { "version": ">= 24.10.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk", "credentialsSource": "remote" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk", "credentialsSource": "remote" }
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle", "credentialsSource": "remote" }
    }
  }
}
